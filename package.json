{
  "name": "pi-agent-bridge",
  "version": "0.1.0",
  "description": "Pi extension that routes prompts to agy, Codex/Grok/Cursor ACP agents",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "agy",
    "antigravity",
    "codex",
    "grok",
    "cursor",
    "acp",
    "provider"
  ],
  "files": [
    "extensions",
    "src",
    "README.md",
    "README_ko.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/antigravity.ts",
      "./extensions/codex.ts",
      "./extensions/grok.ts",
      "./extensions/cursor.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-force-exit 'tests/**/*.test.ts'",
    "test:unit": "node --experimental-strip-types --test --test-force-exit 'tests/*.test.ts'",
    "test:e2e": "node --experimental-strip-types --test --test-force-exit 'tests/e2e/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
